// nextflow.config
// Run locally with Docker by default: nextflow run main.nf -profile docker

manifest {
    name            = 'nf-variant-pipeline'
    description     = 'Minimal germline variant-calling pipeline (BWA -> GATK -> bcftools)'
    author          = 'Syed Nurul Hasan'
    nextflowVersion = '>=23.10.0'
}

// outdir must be defined here (not just in the pipeline scripts) because
// report/timeline/trace file paths below are resolved when this config is
// parsed, before either script runs — and a script-body `params.outdir = ...`
// assignment can't override a value already set here. This config is shared
// by both main.nf (germline) and somatic.nf (tumor-normal), so the default
// branches on --tumor_reads, a param only the somatic pipeline ever sets, to
// give each pipeline its own results/ vs results_somatic/ output root without
// requiring an explicit --outdir on the command line.
params {
    outdir = params.containsKey('tumor_reads') ? "${projectDir}/results_somatic" : "${projectDir}/results"
}

// Default resources for every process; override per-process with withName {}
process {
    cpus   = 2
    memory = '4 GB'
    time   = '1h'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Example HPC/Slurm profile — adjust queue/account for a real cluster
    slurm {
        process.executor = 'slurm'
        process.queue    = 'general'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Example cloud profile (AWS Batch) — fill in your own bucket/queue
    awsbatch {
        process.executor    = 'awsbatch'
        process.queue       = 'my-batch-queue'
        workDir              = 's3://my-bucket/work'
        aws.region           = 'us-east-1'
    }
}

// Per-process resource overrides (HaplotypeCaller is the heaviest step)
process {
    withName: HAPLOTYPE_CALLER {
        cpus   = 4
        memory = '8 GB'
    }
}

// Generate an execution report + timeline automatically on every run
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
